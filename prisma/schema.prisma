// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  client_id           String    @id @default(cuid())
  first_name          String    @db.VarChar(50)
  last_name           String    @db.VarChar(50)
  email               String    @unique @db.VarChar(100)
  phone               String?   @db.VarChar(20)
  address             String?
  payment_method      String?   @db.VarChar(50)
  hourly_rate         Decimal
  balance             Decimal   @default(0.00)
  created_at          DateTime  @default(now()) @db.Timestamp()
  active_status       Boolean   @default(true)
  password_hash       String?
  role                String    @default("client") @db.VarChar
  reset_token         String?
  reset_token_expires DateTime?
  last_login          DateTime?
  street_address      String?   @db.VarChar
  city                String?   @db.VarChar
  state               String?   @db.VarChar
  zip_code            String?   @db.VarChar
  students            Student[]
  sessions            Session[]
  payments            Payment[]
  messages Message[]

  @@map("clients")
}

model Tutor {
  tutor_id             String    @id @default(cuid())
  first_name           String    @db.VarChar(50)
  last_name            String    @db.VarChar(50)
  email                String    @unique @db.VarChar(100)
  phone                String?   @db.VarChar(20)
  address              String?
  max_distance         Decimal?
  payment_method       String?   @db.VarChar(20)
  payment_details      String?
  hourly_rate          Decimal
  min_grade_level      Int?
  max_grade_level      Int?
  active_status        Boolean   @default(true)
  created_at           DateTime  @default(now()) @db.Timestamp()
  password_hash        String
  role                 String    @default("tutor") @db.VarChar
  sex                  String    @db.VarChar(10)
  reset_token          String?
  reset_token_expires  DateTime?
  preferred_name       String?   @db.VarChar
  last_login           DateTime?
  students             Student[]
  sessions             Session[]
  tutorSubjects        TutorSubject[]
  tutorAvailability    TutorAvailability?
  tutorPayments        TutorPayment[]

  @@map("tutors")
}

model Student {
  student_id  String   @id @default(cuid())
  client_id   String
  tutor_id    String
  first_name  String   @db.VarChar(50)
  last_name   String   @db.VarChar(50)
  grade       Int?
  school      String?  @db.VarChar(100)
  client      Client   @relation(fields: [client_id], references: [client_id])
  tutor       Tutor    @relation(fields: [tutor_id], references: [tutor_id])
  sessions    Session[]


  @@map("students")
}

model TutorAvailability {
  id          String  @id @default(cuid())
  tutor_id    String  @unique
  monday      Boolean @default(false)
  tuesday     Boolean @default(false)
  wednesday   Boolean @default(false)
  thursday    Boolean @default(false)
  friday      Boolean @default(false)
  saturday    Boolean @default(false)
  sunday      Boolean @default(false)
  notes       String? @db.Text
  tutor       Tutor   @relation(fields: [tutor_id], references: [tutor_id])

  @@map("tutor_availability")
}



model Session {
  session_id  String   @id @default(cuid())
  tutor_id    String
  student_id  String
  client_id   String
  start_time  DateTime
  end_time    DateTime
  duration    Decimal?
  subject     String   @db.VarChar(100)
  notes       String?  @db.Text
  tutor       Tutor    @relation(fields: [tutor_id], references: [tutor_id])
  student     Student  @relation(fields: [student_id], references: [student_id])
  client      Client   @relation(fields: [client_id], references: [client_id])

  @@map("sessions")
}

model Payment {
  payment_id      String   @id @default(cuid())
  client_id       String
  amount          Decimal
  payment_date    DateTime
  payment_method  String?  @db.VarChar(50)
  status          String   @db.VarChar(20)
  client          Client   @relation(fields: [client_id], references: [client_id])

  @@map("payments")
}

model TutorPayment {
  payment_id      String   @id @default(cuid())
  tutor_id        String
  amount          Decimal
  payment_date    DateTime
  status          String   @db.VarChar(20)
  tutor           Tutor    @relation(fields: [tutor_id], references: [tutor_id])

  @@map("tutor_payments")
}

model Subject {
  subject_id    Int            @id @default(autoincrement())
  name          String         @db.VarChar(100)
  tutor_subjects TutorSubject[]

  @@map("subjects")
}

model TutorSubject {
  tutor_id    String
  subject_id  Int
  tutor       Tutor    @relation(fields: [tutor_id], references: [tutor_id])
  subject     Subject  @relation(fields: [subject_id], references: [subject_id])

  @@id([tutor_id, subject_id])
  @@map("tutor_subjects")
}

model Message {
  message_id      String   @id @default(cuid())
  client_id       String
  admin_id        String
  content         String   @db.VarChar(2000)
  timestamp       DateTime @default(now()) @db.Timestamp()
  is_read         Boolean  @default(false)
  is_from_client  Boolean
  subject         String?  @db.VarChar(100)

  client Client @relation(fields: [client_id], references: [client_id])
  admin  Admin  @relation(fields: [admin_id], references: [admin_id])
  @@map("messages")
}
model Admin {
  admin_id            String    @id @default(cuid())
  username            String    @unique @db.VarChar(50)
  password_hash       String
  first_name          String    @db.VarChar(50)
  last_name           String    @db.VarChar(50)
  email               String    @unique @db.VarChar(100)
  phone               String?   @db.VarChar(20)
  role                String    @default("admin") @db.VarChar(20)
  created_at          DateTime  @default(now()) @db.Timestamp()
  last_login          DateTime?
  is_active           Boolean   @default(true)
  reset_token         String?
  reset_token_expires DateTime?
  messages Message[]

  @@map("admins")
}
